{
  "name": "conversation-cheatsheet",
  "productName": "대화 치트키",
  "version": "0.1.0",
  "description": "선택한 텍스트로 대화 문장, 예상 질문 답변, 화제 전환을 제공하는 Windows 데스크톱 대화 보조 앱",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "smoke": "node scripts/smoke.js",
    "check": "node scripts/check.js",
    "pdf": "electron scripts/make-pdf.js",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.kirothon.conversation-cheatsheet",
    "productName": "대화 치트키",
    "files": ["src/**/*", "package.json"],
    "asarUnpack": ["src/native/**"],
    "win": { "target": ["portable"] }
  }
}
